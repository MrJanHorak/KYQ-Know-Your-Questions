rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['question','lessonReference','authorName','upvotes','upvoteCount','status','createdAt','replies'])
        && request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 2000
        && request.resource.data.lessonReference is string && request.resource.data.lessonReference.size() <= 500
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.upvotes == [] && request.resource.data.upvoteCount == 0
        && request.resource.data.status == 'unanswered' && request.resource.data.createdAt == request.time && request.resource.data.replies == [];
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes','upvoteCount'])
         && !(request.auth.uid in resource.data.upvotes)
         && request.resource.data.upvotes.hasAll(resource.data.upvotes)
         && request.auth.uid in request.resource.data.upvotes
         && request.resource.data.upvotes.size() == resource.data.upvotes.size() + 1
         && request.resource.data.upvoteCount == resource.data.upvoteCount + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
         && request.resource.data.replies.size() == resource.data.replies.size() + 1
         && request.resource.data.replies.hasAll(resource.data.replies))
      );
      allow delete: if false;
    }
  }
}
