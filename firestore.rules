rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId}/questions/{id} {
      function hasAccess() {
        return request.auth != null
          && request.auth.token.boardId == boardId
          && get(/databases/$(database)/documents/boards/$(boardId)).data.get('teamId', null) is string
          && get(/databases/$(database)/documents/boards/$(boardId)).data.get('deleting', false) == false
          && (request.auth.token.get('managerUid', null) == null
            || (exists(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/boards/$(boardId)).data.teamId))
              && (get(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/boards/$(boardId)).data.teamId)/members/$(request.auth.token.managerUid)).data.get('role', '') == 'owner'
                || get(/databases/$(database)/documents/boards/$(boardId)/admins/$(request.auth.token.managerUid)).data.get('role', '') in ['responder', 'moderator', 'manager', 'admin'])))
          && request.auth.token.get('accessVersion', 0) == get(/databases/$(database)/documents/boards/$(boardId)).data.get('accessVersion', 0);
      }
      allow read: if hasAccess();
      allow create: if hasAccess()
        && request.resource.data.keys().hasOnly(['question','lessonReference','authorName','authorUid','upvotes','upvoteCount','status','createdAt','replies'])
        && request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 2000
        && request.resource.data.lessonReference is string && request.resource.data.lessonReference.size() <= 500
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.upvotes == [] && request.resource.data.upvoteCount == 0
        && request.resource.data.status == 'unanswered' && request.resource.data.createdAt == request.time && request.resource.data.replies == [];
      allow update: if hasAccess() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes','upvoteCount'])
         && !(request.auth.uid in resource.data.upvotes)
         && request.resource.data.upvotes.hasAll(resource.data.upvotes)
         && request.auth.uid in request.resource.data.upvotes
         && request.resource.data.upvotes.size() == resource.data.upvotes.size() + 1
         && request.resource.data.upvoteCount == resource.data.upvoteCount + 1)
        || (resource.data.get('authorUid', '') == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['question','lessonReference'])
         && request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 2000
         && request.resource.data.lessonReference is string && request.resource.data.lessonReference.size() <= 500)
      );
      allow delete: if false;
    }
  }
}
